# SciTeX umbrella — environment variable reference.
#
# Copy to `.env` and uncomment the lines you need; SciTeX reads these via
# `scitex.helpers.load_scitex_env()` (delegated to scitex-config). Every var
# is OPTIONAL — sensible defaults apply when unset. Module-prefixed vars
# (SCITEX_<MODULE>_*) configure the corresponding peer module.

# --- Core paths -------------------------------------------------------------
# Base directory for SciTeX runtime state (defaults to ./.scitex or ~/.scitex).
# SCITEX_DIR=
# Project root override (auto-detected from the git toplevel by default).
# SCITEX_PROJ_ROOT=

# --- scitex.scholar ---------------------------------------------------------
# Library root for fetched papers / PDFs / metadata.
# SCITEX_SCHOLAR_DIR=

# --- scitex.web -------------------------------------------------------------
# Download directory for web-fetched artifacts.
# SCITEX_WEB_DOWNLOADS_DIR=

# --- scitex.social (credentials for social-posting integrations) ------------
# SCITEX_SOCIAL_X_CONSUMER_KEY=
# SCITEX_SOCIAL_REDDIT_CLIENT_ID=
# SCITEX_SOCIAL_LINKEDIN_ACCESS_TOKEN=
# SCITEX_SOCIAL_YOUTUBE_API_KEY=

# --- MCP --------------------------------------------------------------------
# Toggle individual peer MCP servers, e.g. SCITEX_MCP_USE_IO=1 (prefix form).
# SCITEX_MCP_USE_<PEER>=
